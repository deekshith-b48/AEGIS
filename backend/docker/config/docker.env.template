# Project AEGIS Environment Configuration Template
# Copy this file to .env and update the values

# Environment
AEGIS_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
JWT_SECRET_KEY=jwt-secret-key-change-this-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegis_db
DB_USER=aegis_user
DB_PASSWORD=your-database-password-change-this
DB_SSL_MODE=prefer
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://:your-redis-password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-change-this
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=aegis
KAFKA_CONSUMER_GROUP=aegis-consumers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000

# Application Configuration
APP_NAME=Project AEGIS
APP_VERSION=2.0.0
APP_DESCRIPTION=Advanced Cybercrime Response System
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
APP_MAX_REQUESTS=1000
APP_MAX_REQUESTS_JITTER=100
APP_WORKER_TIMEOUT=120
APP_WORKER_CONNECTIONS=1000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://aegis.gov.in
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_STORAGE=redis://redis:6379

# File Upload Configuration
MAX_UPLOAD_SIZE=50MB
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,gif,mp4,avi,mov
UPLOAD_CHUNK_SIZE=8192

# External API Configuration
NPCI_API_URL=https://api.npci.org
NPCI_API_KEY=your-npci-api-key
NPCI_API_SECRET=your-npci-api-secret
NPCI_WEBHOOK_SECRET=your-npci-webhook-secret
NPCI_TIMEOUT=30

NCRP_API_URL=https://ncrp.gov.in/api
NCRP_API_KEY=your-ncrp-api-key
NCRP_API_SECRET=your-ncrp-api-secret
NCRP_TIMEOUT=30

I4C_API_URL=https://i4c.gov.in/api
I4C_API_KEY=your-i4c-api-key
I4C_API_SECRET=your-i4c-api-secret
I4C_TIMEOUT=30

CFCFRMS_API_URL=https://cfcfrms.gov.in/api
CFCFRMS_API_KEY=your-cfcfrms-api-key
CFCFRMS_API_SECRET=your-cfcfrms-api-secret
CFCFRMS_TIMEOUT=30

# AI Model Configuration
AI_MODEL_PATH=/app/models
AI_ENABLE_GPU=false
AI_MODEL_TIMEOUT=60
AI_BATCH_SIZE=32
AI_MAX_WORKERS=4

# CST Transformer Configuration
CST_MODEL_VERSION=1.0.0
CST_MODEL_PATH=/app/models/cst_transformer
CST_MAX_PREDICTIONS=10
CST_CONFIDENCE_THRESHOLD=0.7

# Federated Causal Graph Configuration
FCG_MODEL_VERSION=1.0.0
FCG_MODEL_PATH=/app/models/federated_causal_graph
FCG_UPDATE_INTERVAL=300
FCG_MIN_DATA_POINTS=100

# Behavioral Digital Twin Configuration
BDT_MODEL_VERSION=1.0.0
BDT_MODEL_PATH=/app/models/behavioral_digital_twin
BDT_SIMULATION_HORIZON=24
BDT_STATE_SIZE=1000

# Risk Scoring Engine Configuration
RSE_MODEL_VERSION=1.0.0
RSE_MODEL_PATH=/app/models/risk_scoring_engine
RSE_THRESHOLD_HIGH=0.8
RSE_THRESHOLD_MEDIUM=0.6
RSE_THRESHOLD_LOW=0.4

# Privacy and Security Configuration
K_ANONYMITY_K=50
DIFFERENTIAL_PRIVACY_EPSILON=0.5
SMPC_PARTIES=3
ENCRYPTION_KEY_ROTATION_DAYS=30
DATA_RETENTION_DAYS=365

# Alert System Configuration
ALERT_BATCH_SIZE=100
ALERT_RETRY_ATTEMPTS=3
ALERT_RETRY_DELAY=5
ALERT_MAX_PER_MINUTE=1000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true
EMAIL_FROM=aegis@aegis.gov.in
EMAIL_FROM_NAME=Project AEGIS

# SMS Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Configuration
WHATSAPP_PROVIDER=twilio
WHATSAPP_PHONE_NUMBER=+1234567890

# Push Notification Configuration
PUSH_PROVIDER=fcm
FCM_SERVER_KEY=your-fcm-server-key
FCM_API_KEY=your-fcm-api-key

# Monitoring and Metrics Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
PROMETHEUS_GATEWAY_URL=http://prometheus:9091

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=/app/logs/aegis.log
LOG_ROTATION=daily
LOG_RETENTION=30
LOG_LEVEL_SQL=WARN

# Jaeger Tracing Configuration
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Performance Configuration
ENABLE_CACHING=true
CACHE_TTL=300
CACHE_MAX_SIZE=10000
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=aegis-backups
BACKUP_S3_REGION=ap-south-1

# Development Configuration (only used in development)
MOCK_EXTERNAL_APIS=false
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_PROFILING=false
PERFORMANCE_MONITORING=false

# Feature Flags
ENABLE_WEBHOOKS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_MACHINE_LEARNING=true
ENABLE_BLOCKCHAIN_AUDIT=true
ENABLE_DIGITAL_CORDON=true
ENABLE_MULTI_CHANNEL_ALERTS=true